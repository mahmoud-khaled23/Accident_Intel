# --- Accident-Intel root .env.example ---

# Mock flags (set to false to enable real AI processing)
TRACKING_MOCK=true
VLM_MOCK=true
REASONING_MOCK=true
RAG_MOCK=false
DAMAGE_MOCK=true

# OpenAI (used by reasoning service when REASONING_MOCK=false)
OPENAI_API_KEY=sk-...
REASONING_MODEL=gpt-4o-mini

# Gemini (alternative VLM backend)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Local VLM (Qwen2-VL) settings
VLM_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct
VLM_N_FRAMES=32
VLM_MAX_TOKENS=700

# Storage
DATA_DIR=out
DB_PATH=out/accident_intel.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
