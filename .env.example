# Set every mock switch to false to analyze real uploaded videos.
TRACKING_MOCK=false
VLM_MOCK=false
RAG_MOCK=false
REASONING_MOCK=false
DAMAGE_MOCK=false

TRACKING_MODEL_PATH=yolo11x.pt

# Hosted VLM (OpenAI-compatible provider)
VLM_API=openai
VLM_BASE_URL=https://api.groq.com/openai/v1
VLM_MODEL=your_vision_model
VLM_API_KEY=your_vlm_api_key

# Liability-reasoning LLM (OpenAI-compatible provider)
OPENAI_API_KEY=your_reasoning_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
REASONING_MODEL=your_reasoning_model

# Storage and browser access
DATA_DIR=out
DB_PATH=out/accident_intel.db
CORS_ORIGINS=["http://localhost:5173"]

# Frames are grouped into timestamped contact sheets for hosted model image limits.
VLM_MAX_IMAGES=3
VLM_N_FRAMES=16
VLM_MAX_TOKENS=1400
RAG_OUT_DIR=src/rag/chunking/out
RAG_MODE=hybrid
RAG_RERANK=true
MAX_UPLOAD_MB=500
