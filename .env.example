# Live inference is the default. Enable mocks only for explicit development fixtures.
TRACKING_MOCK=false
VLM_MOCK=false
RAG_MOCK=false
REASONING_MOCK=false
DAMAGE_MOCK=false

TRACKING_MODEL_PATH=weights/vehicle_tracking/yolo11x.pt

# auto: local Qwen2-VL on a CUDA GPU, hosted API otherwise.
# React can override this per upload/retry with auto, local, or openai.
VIDEO_VLM_API=auto
VLM_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct
VIDEO_VLM_BASE_URL=https://api.openai.com/v1
VIDEO_VLM_MODEL=
VIDEO_VLM_API_KEY=
VLM_N_FRAMES=4
VLM_MAX_IMAGES=1
VLM_MAX_TOKENS=700
VIDEO_VLM_EXTRA_PARAMS={}

# Reasoning uses an API in both video modes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REASONING_MODEL=gpt-4o-mini

# Relative paths resolve from the repository root.
DATA_DIR=data
DB_PATH=data/accident_intel.db
RAG_OUT_DIR=data/traffic_laws/chunks
RAG_MODE=hybrid
RAG_RERANK=true
MAX_UPLOAD_MB=500
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Separate repair-cost configuration; VLM_API never selects the video backend.
DAMAGE_WEIGHTS=weights/car_damage_cost/damage_segmentation.pt
PARTS_WEIGHTS=weights/car_damage_cost/parts_segmentation.pt
PRICES_PATH=data/prices.json
OVERLAP_THRESHOLD=0.30
VLM_QUALITY_CHECK=1
VLM_SEVERITY=0
VLM_API=openai
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=
VLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
